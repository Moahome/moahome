# .deploy.env로 복사합니다. 이 파일에는 비밀값을 넣지 않습니다.
COMPOSE_PROJECT_NAME=moahome-prod
API_DOMAIN=api.example.com
API_IMAGE=ghcr.io/your-owner/moahome-api:COMMIT_SHA
# 로컬에서 검증한 digest입니다. API만 배포할 때는 이 이미지를 갱신하지 않습니다.
REDIS_IMAGE=redis:8-alpine@sha256:21090af93f8324db2f0f0f4f38a7c60369d47d917e000c3423d89d2ae2883537
NGINX_IMAGE=nginx:stable-alpine@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949
