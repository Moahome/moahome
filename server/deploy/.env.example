# .env.prod로 복사하고 실제 값은 서버에서만 입력합니다. 셸에서 source하지 않습니다.
# Compose raw env_file 형식입니다. 값 전체를 따옴표로 감싸지 않습니다.
SPRING_DATASOURCE_URL=jdbc:postgresql://RDS_ENDPOINT:5432/moahome?sslmode=verify-full&sslrootcert=/etc/rds/rds-ca.pem
SPRING_DATASOURCE_USERNAME=moahome_app
SPRING_DATASOURCE_PASSWORD=
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
WEB_ALLOWED_ORIGINS=https://app.example.com
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://api.example.com/login/oauth2/code/kakao
WEB_LOGIN_SUCCESS_URI=https://app.example.com/login/callback
JWT_ACCESS_SECRET_BASE64=
JWT_REFRESH_SECRET_BASE64=
ACCOUNT_ENCRYPTION_KEY_BASE64=
ACCOUNT_HMAC_KEY_BASE64=
REGISTRATION_FINGERPRINT_KEY_BASE64=
PHONE_ENCRYPTION_KEY_BASE64=
PHONE_HMAC_KEY_BASE64=
# 프로필 사진을 사용할 때 운영 전용 버킷과 해당 profiles/* 접근 인증을 설정합니다.
# Mac의 AWS_PROFILE=moahome-dev는 운영에 복사하지 않습니다.
S3_BUCKET_NAME=
AWS_REGION=ap-northeast-2
# 역할 인증을 제공할 수 없는 실행 환경에서만 서버 전용 IAM 키를 주입합니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 임시 인증을 주입한다면 AWS_SESSION_TOKEN도 함께 설정합니다.
TZ=Asia/Seoul
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1536m -Duser.timezone=Asia/Seoul
